generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  slug         String    @unique
  description  String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@index([isActive])
  @@index([displayOrder])
  @@map("categories")
}

model Product {
  id           String         @id @default(uuid()) @db.Uuid
  slug         String         @unique
  title        String
  subtitle     String?
  description  Json
  price        Decimal        @db.Decimal(10, 2)
  currency     String         @default("INR")
  packageSize  String?
  status       ProductStatus  @default(DRAFT)
  isFeatured   Boolean        @default(false)
  isAvailable  Boolean        @default(true)
  displayOrder Int            @default(0)
  categoryId   String         @db.Uuid
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  publishedAt  DateTime?
  images       ProductImage[]
  category     Category       @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([isAvailable])
  @@index([displayOrder])
  @@index([status, isAvailable, displayOrder])
  @@map("products")
}

model Asset {
  id            String         @id @default(uuid()) @db.Uuid
  fileName      String
  mimeType      String
  size          Int
  storageKey    String         @unique
  publicUrl     String?
  width         Int?
  height        Int?
  altText       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  productImages ProductImage[]

  @@map("assets")
}

model ProductImage {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @db.Uuid
  assetId      String   @db.Uuid
  altText      String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
  @@index([productId, isPrimary])
  @@map("product_images")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

// The users, carts, and cart_items tables already exist in the shared database.
// They are owned and migrated by the user-and-cart-service (raw SQL migrations
// tracked in its schema_migrations table), so these models only map them for
// querying - never create Prisma migrations for them.

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  googleId        String?   @unique @map("google_id") @db.VarChar(255)
  email           String    @unique @db.VarChar(320)
  firstName       String?   @map("first_name") @db.VarChar(255)
  lastName        String?   @map("last_name") @db.VarChar(255)
  displayName     String?   @map("display_name") @db.VarChar(255)
  profileImageUrl String?   @map("profile_image_url")
  emailVerified   Boolean   @default(false) @map("email_verified")
  status          String    @default("ACTIVE") @db.VarChar(20)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  carts           Cart[]

  @@map("users")
}

model Cart {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?    @map("user_id") @db.Uuid
  anonymousId    String?    @map("anonymous_id") @db.Uuid
  status         String     @default("ACTIVE") @db.VarChar(20)
  currency       String     @default("INR") @db.VarChar(3)
  subtotal       Decimal    @default(0) @db.Decimal(12, 2)
  discountAmount Decimal    @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal    @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount    Decimal    @default(0) @map("total_amount") @db.Decimal(12, 2)
  expiresAt      DateTime?  @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  user           User?      @relation(fields: [userId], references: [id])
  items          CartItem[]

  @@index([userId])
  @@index([anonymousId])
  @@map("carts")
}

model CartItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId      String   @map("cart_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(255)
  productSlug String   @map("product_slug") @db.VarChar(255)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  totalPrice  Decimal  @map("total_price") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}
